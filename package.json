{
  "name": "news-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Corroboration-weighted news intelligence system (see SPEC.md)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "tsx src/scripts/migrate.ts up",
    "migrate:down": "tsx src/scripts/migrate.ts down",
    "seed": "tsx src/scripts/seed.ts",
    "seed-feeds": "tsx src/scripts/seed-feeds.ts",
    "discover": "tsx src/scripts/discover.ts",
    "status": "tsx src/scripts/status.ts",
    "ingest": "tsx src/jobs/ingest.ts",
    "cluster": "tsx src/jobs/cluster.ts",
    "enrich": "tsx src/jobs/enrich.ts",
    "analyse": "tsx src/jobs/analyse.ts",
    "deliver": "tsx src/jobs/deliver.ts",
    "counter": "tsx src/jobs/counter.ts",
    "retention": "tsx src/scripts/retention.ts",
    "backup": "tsx src/scripts/backup.ts",
    "alert": "tsx src/scripts/alert.ts",
    "dev": "next dev",
    "build:web": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "dotenv": "^16.4.7",
    "next": "^16.2.12",
    "node-pg-migrate": "^7.9.0",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rss-parser": "^3.13.0",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
