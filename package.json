{
  "name": "news-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Corroboration-weighted news intelligence system (see SPEC.md)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "tsx src/scripts/migrate.ts up",
    "migrate:down": "tsx src/scripts/migrate.ts down",
    "seed": "tsx src/scripts/seed.ts",
    "discover": "tsx src/scripts/discover.ts",
    "status": "tsx src/scripts/status.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "node-pg-migrate": "^7.9.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
