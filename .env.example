# Neon: use the POOLED connection string, not the direct endpoint.
# Neon console -> Connection Details -> "Pooled connection"
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/news?sslmode=require"

# Anthropic. console.anthropic.com -> API keys. Billed by usage, separate
# from any Claude subscription.
ANTHROPIC_API_KEY=""
# Per-cluster scoring (Sonnet) and daily synthesis (Opus). See SPEC.md 3.2.
ANALYSIS_MODEL="claude-sonnet-5"
SYNTHESIS_MODEL="claude-opus-5"

# Hosted multilingual embedding provider. Must be explicitly multilingual;
# cross-lingual clustering is verified in Phase 2, not assumed. See SPEC.md 3.3.
# EMBEDDING_PROVIDER: voyage (default) | openai | cohere. Set MODEL/DIMS to match.
EMBEDDING_PROVIDER="voyage"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL=""
EMBEDDING_DIMS="1024"

# GDELT volume lookups in enrich (SPEC.md 7.4) are context-only and rate-limited;
# off by default. Set to 1 to enable.
ENRICH_GDELT=""

# Transactional mail, one recipient. MAIL_PROVIDER: resend (default) | postmark.
MAIL_PROVIDER="resend"
MAIL_API_KEY=""
MAIL_FROM=""
DIGEST_RECIPIENT=""

# Signing key for counter-edition feedback links (SPEC.md 9.5.4).
# Generate with: openssl rand -hex 32
FEEDBACK_SIGNING_SECRET=""

# Scheduling. Actions cron is UTC only; jobs guard on local hour.
TZ="America/Toronto"
ANALYSIS_LOCAL_HOUR="5"        # daily analysis pass, before the digest
# Manual/forced runs: FORCE_RUN=1 skips the local-hour guard (also skipped on a
# GitHub workflow_dispatch). ANALYSE_MAX_CLUSTERS caps clusters scored per run
# (0 = unlimited), most-corroborated first — useful for a first backlog pass.
FORCE_RUN=""
ANALYSE_MAX_CLUSTERS=""
TARGET_LOCAL_HOUR="6"          # daily digest
COUNTER_LOCAL_HOUR="7"         # fortnightly counter edition, Sunday

# Contact address published in the User-Agent string on every feed poll.
FEED_CONTACT_EMAIL=""
